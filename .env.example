# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# Thư mục gốc chứa mã nguồn cần phân tích (gắn read-only vào container), vd D:/projects
SOURCE_ROOT=

# CSDL của tool (PostgreSQL chạy trong docker compose)
DB_USER=flowtracer
DB_PASSWORD=flowtracer
# Cổng PostgreSQL mở ra máy (đổi nếu máy đã có PostgreSQL chiếm 5432) — DB_URL phải dùng cùng cổng
DB_PORT=5432
# Khi chạy Engine ngoài Docker:
DB_URL=jdbc:postgresql://localhost:5432/flowtracer

# Engine
APP_PORT=8600
BIND_HOST=127.0.0.1
DATA_DIR=./.data

# AI: gemini | anthropic | openai-compatible | none
LLM_PROVIDER=none
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
# Giới hạn token mỗi ngày do bạn tự đặt (0 = không đặt; Gemini không công bố hạn mức token theo ngày cho gói miễn phí)
LLM_DAILY_TOKEN_LIMIT=0
# true = ghi prompt (đã che secret) và kết quả của mọi lời gọi AI ra log Engine; false = chỉ ghi dòng tóm tắt
LLM_LOG_CONTENT=true
