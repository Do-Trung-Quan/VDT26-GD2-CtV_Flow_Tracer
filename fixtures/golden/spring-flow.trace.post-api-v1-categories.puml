@startuml POST_api_v1_categories
autonumber
skinparam style strictuml
skinparam responseMessageBelowArrow true
actor "Client" as User
participant "Controller Danh mục" as C1
participant "Service Danh mục" as S1
participant "Repository Danh mục" as R1
database "Bảng category" as T1

User -> C1: POST /api/v1/categories
activate C1
C1 -> S1: create(request)
activate S1
S1 -> S1: checkPermission(), normalize()
S1 -> R1: existsByCode(code)
activate R1
R1 -> T1: SELECT
activate T1
T1 --> R1: kết quả
deactivate T1
R1 --> S1: true / false
deactivate R1
alt categoryRepository.existsByCode(code)
  S1 --> C1: CATEGORY_CODE_EXISTS
  C1 --> User: BusinessException
else ngược lại
  S1 -> R1: save(entity)
  activate R1
  R1 -> T1: INSERT/UPDATE
  activate T1
  T1 --> R1: OK
  deactivate T1
  R1 --> S1: Category
  deactivate R1
  S1 -> S1: toResponse()
  S1 --> C1: CategoryResponse
  deactivate S1
  C1 --> User: 200 ApiResponse<CategoryResponse>
  deactivate C1
end
@enduml
