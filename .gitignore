analyzer-node/src/protocol/generated/

# ---------------- Local data & secrets ----------------
.env
.env.*
!.env.example
.data/
# Danh sách từ khóa nội bộ dùng cho scripts/check-forbidden-terms.mjs — không bao giờ commit
.forbidden-terms

