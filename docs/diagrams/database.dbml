// CtV Flow Tracer - Thiết kế cơ sở dữ liệu (PostgreSQL 16)
// Mô tả chi tiết từng bảng: .context/database.md
// Khớp migration Flyway V1 - V6 (engine/flowtracer-app/src/main/resources/db/migration/)
// Docs: https://dbml.dbdiagram.io/docs

// ----------------- Enums -----------------

Enum source_role {
  BACKEND
  FRONTEND
  LEGACY
}

Enum scan_trigger {
  IMPORT
  RESCAN
}

Enum scan_status {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

Enum parse_status {
  OK
  ERROR
  SKIPPED
}

Enum edge_confidence {
  CERTAIN
  INFERRED
  UNRESOLVED
  RUNTIME_VERIFIED
}

Enum override_decision {
  PIN
  REJECT
}

Enum ai_purpose {
  PURPOSE_TEXT
  SCENARIO_POLISH
  MOCK_DATA
  EDGE_RESOLUTION
  ELEMENT_NAMING
  LEGACY_MATCH
  FEATURE_SUMMARY [note: 'Không dùng: nhóm chức năng đã loại khỏi lộ trình; giá trị còn trong enum']
}

Enum llm_call_status {
  OK
  ERROR
  REJECTED_BY_VALIDATION
  QUOTA_EXCEEDED
  CACHE_HIT [note: 'Không dùng: còn lại từ migration V4 (PostgreSQL không xóa được một giá trị enum); V5 đã xóa các dòng dùng nó']
}

// ----------------- Tables -----------------

// --- Cấu hình phân tích ---

Table workspaces {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  name varchar(200) [not null, unique, note: 'Tên Workspace, không trùng']
  description text [null]
  settings jsonb [not null, default: '{}', note: 'manualLinkRules, detectedLinkRules, bộ lọc nhiễu, độ sâu dò vết mặc định']
  last_scan_run_id uuid [null, note: 'Lần quét gần nhất; NULL nếu chưa quét']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Một dự án đang được phân tích. Xóa Workspace thì xóa mọi dữ liệu liên quan trong CSDL, không đụng tới mã nguồn.'
}

Table sources {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  workspace_id uuid [not null]
  name varchar(200) [not null]
  role source_role [not null]
  root_path text [not null, note: 'Tương đối từ SOURCE_ROOT']
  include_globs jsonb [not null, default: '[]', note: 'Chỉ lấy; rỗng = lấy tất cả']
  exclude_globs jsonb [not null, default: '[]', note: 'Bỏ qua; hệ thống tự thêm thư mục của Source con']
  parent_source_id uuid [null, note: 'Source cha nếu thư mục nằm bên trong Source khác']
  detected_stacks jsonb [not null, default: '[]', note: 'Công nghệ nhận diện được, sửa tay được']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    workspace_id
  }

  Note: 'Một thư mục mã nguồn của Workspace kèm vai trò (Backend / Frontend / hệ thống cũ).'
}

// --- Kết quả phân tích (sinh lại được bằng cách quét lại) ---

Table scan_runs {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  workspace_id uuid [not null]
  trigger scan_trigger [not null, note: 'IMPORT phân tích toàn bộ; RESCAN chỉ file đã đổi']
  status scan_status [not null]
  stats jsonb [not null, default: '{}', note: 'Số file theo loại, số node / edge / endpoint, chẩn đoán, thời gian từng giai đoạn, kết quả từng Source']
  error_summary text [null, note: 'Nguyên nhân lỗi chung khi FAILED']
  started_at timestamptz [not null]
  finished_at timestamptz [null]

  indexes {
    (workspace_id, started_at) [name: 'idx_scan_runs_workspace']
  }

  Note: 'Một lần quét mã nguồn: tiến độ, lịch sử, kết quả hiện tại đến từ lần quét nào.'
}

Table source_files {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  source_id uuid [not null]
  rel_path text [not null, note: 'Tính từ thư mục của Source']
  content_hash char(64) [not null, note: 'SHA-256 nội dung, cơ sở của quét lại tăng dần']
  language varchar(20) [not null, note: 'java, ts, html, php...; config = file cấu hình chỉ lưu mã băm']
  size_bytes integer [not null]
  parse_status parse_status [not null]
  parse_error text [null]
  last_scan_run_id uuid [not null]

  indexes {
    (source_id, rel_path) [unique]
  }

  Note: 'Một file mã nguồn đã được đọc, kèm mã băm nội dung.'
}

Table ir_nodes {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  workspace_id uuid [not null]
  key text [not null, note: 'Định danh ổn định qua các lần quét; dữ liệu người dùng và cache AI trỏ tới node bằng key']
  kind varchar(30) [not null, note: 'UI_SCREEN, UI_ELEMENT, API_ENDPOINT, BE_METHOD, DB_TABLE...']
  source_id uuid [not null]
  file_id uuid [null, note: 'NULL với thành phần suy ra, không nằm trong file cụ thể']
  name text [not null, note: 'Tên kỹ thuật trong code']
  display_name text [null, note: 'Tên thân thiện tiếng Việt']
  start_line integer [null]
  end_line integer [null]
  attrs jsonb [not null, default: '{}']
  search_text tsvector [null, note: 'GENERATED ALWAYS STORED: to_tsvector simple của name + display_name + key']

  indexes {
    (workspace_id, key) [unique]
    (workspace_id, kind) [name: 'idx_ir_nodes_kind']
    search_text [type: gin]
  }

  Note: 'Một thành phần trên bản đồ của dự án: nút bấm, màn hình, hàm, endpoint, truy vấn, bảng dữ liệu.'
}

Table ir_edges {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  workspace_id uuid [not null]
  from_node_id uuid [not null]
  to_node_id uuid [null, note: 'NULL khi chưa xác định được đích']
  kind varchar(30) [not null, note: 'TRIGGERS, CALLS, HTTP_REQUEST, READS, WRITES, CONTAINS...']
  confidence edge_confidence [not null, note: 'AI không bao giờ đổi giá trị này; chốt tay nằm ở link_overrides']
  reason text [null]
  call_order integer [null]
  guard jsonb [null, note: 'Điều kiện bao quanh lời gọi']
  candidates jsonb [null, note: 'Các đích có thể kèm điểm khớp khi có nhiều khả năng']
  file_id uuid [null]
  line integer [null]

  indexes {
    from_node_id [name: 'idx_ir_edges_from']
    to_node_id [name: 'idx_ir_edges_to']
  }

  Note: 'Một quan hệ có hướng giữa hai thành phần; mỗi mũi tên trên sequence diagram là một edge.'
}

// --- Dữ liệu người dùng (không sinh lại được) ---

Table link_overrides {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  workspace_id uuid [not null]
  from_node_key text [not null]
  to_node_key text [null, note: 'NULL khi chỉ loại bỏ liên kết (REJECT); bắt buộc khi PIN']
  edge_kind varchar(30) [not null]
  decision override_decision [not null]
  note text [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    workspace_id [name: 'idx_link_overrides_workspace']
  }

  Note: 'Quyết định chốt tay của người dùng: ghim hoặc loại bỏ một liên kết. Luôn thắng kết quả tự động, giữ qua mọi lần quét lại. Ràng buộc CHECK: decision khác PIN hoặc to_node_key không NULL.'
}

Table app_settings {
  key varchar(100) [primary key, not null, note: 'ai.purposes | ai.daily_request_limit']
  value jsonb [not null, note: 'Vd {"PURPOSE_TEXT":true} hoặc {"limit":20,"model":"gemini-2.5-flash"}']
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Cấu hình chung chỉnh được trên giao diện. Không chứa API key hay lựa chọn provider / model (chỉ nằm trong biến môi trường).'
}

// --- AI ---

Table ai_artifacts {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  workspace_id uuid [not null]
  target_key text [not null, note: 'Key thành phần / id luồng / key màn hình (đặt tên) / id liên kết kèm mã băm chuỗi gọi (phân tích liên kết)']
  purpose ai_purpose [not null]
  input_hash char(64) [not null, note: 'SHA-256 của phiên bản prompt + nội dung prompt; không gồm model']
  prompt_version varchar(20) [not null]
  provider varchar(50) [not null]
  model varchar(50) [not null]
  content jsonb [not null, note: 'Kết quả AI đã được kiểm tra hợp lệ']
  created_at timestamptz [not null, default: `now()`]
  hit_count integer [not null, default: 0, note: 'Bộ đếm lượt dùng lại; hiện không hiển thị ở đâu và thực tế chưa ghi được (API đọc chạy trong giao dịch chỉ-đọc)']
  last_hit_at timestamptz [null]

  indexes {
    (workspace_id, purpose, target_key, input_hash) [unique, name: 'uq_ai_artifacts_input']
  }

  Note: 'Bộ nhớ đệm nội dung do AI sinh, khóa theo mã băm đầu vào. Trỏ tới node bằng key, không có khóa ngoại tới ir_nodes.'
}

Table llm_call_logs {
  id uuid [primary key, not null, default: `gen_random_uuid()`]
  workspace_id uuid [null, note: 'NULL với lời gọi hệ thống (kiểm tra kết nối) hoặc khi Workspace đã bị xóa']
  purpose varchar(30) [not null, note: 'Tên mục đích AI hoặc CONNECTION_TEST']
  provider varchar(50) [not null]
  model varchar(50) [not null]
  prompt_hash char(64) [not null, note: 'Chỉ lưu mã băm, không lưu nội dung prompt']
  input_tokens integer [null]
  output_tokens integer [null]
  latency_ms integer [null]
  status llm_call_status [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    created_at [name: 'idx_llm_call_logs_created']
  }

  Note: 'Nhật ký mỗi lần gọi AI để theo dõi chi phí, hạn mức, lỗi. Không lưu nội dung gửi đi.'
}

// ----------------- Nhóm bảng -----------------

TableGroup cau_hinh_phan_tich {
  workspaces
  sources
}

TableGroup ket_qua_phan_tich {
  scan_runs
  source_files
  ir_nodes
  ir_edges
}

TableGroup ai {
  ai_artifacts
  llm_call_logs
}

TableGroup du_lieu_nguoi_dung {
  link_overrides
  app_settings
}

// ----------------- Relationships -----------------

Ref: sources.workspace_id > workspaces.id [delete: cascade]
Ref: sources.parent_source_id > sources.id [delete: set null]
Ref: scan_runs.workspace_id > workspaces.id [delete: cascade]
Ref: workspaces.last_scan_run_id - scan_runs.id [delete: set null]
Ref: source_files.source_id > sources.id [delete: cascade]
Ref: source_files.last_scan_run_id > scan_runs.id
Ref: ir_nodes.workspace_id > workspaces.id [delete: cascade]
Ref: ir_nodes.source_id > sources.id [delete: cascade]
Ref: ir_nodes.file_id > source_files.id [delete: cascade]
Ref: ir_edges.workspace_id > workspaces.id [delete: cascade]
Ref: ir_edges.from_node_id > ir_nodes.id [delete: cascade]
Ref: ir_edges.to_node_id > ir_nodes.id [delete: cascade]
Ref: ir_edges.file_id > source_files.id [delete: cascade]
Ref: link_overrides.workspace_id > workspaces.id [delete: cascade]
Ref: ai_artifacts.workspace_id > workspaces.id [delete: cascade]
Ref: llm_call_logs.workspace_id > workspaces.id [delete: set null]

// Liên kết mềm (không dùng khóa ngoại, trỏ bằng ir_nodes.key để sống qua các lần quét):
//   link_overrides.from_node_key / to_node_key -> ir_nodes.key
//   ai_artifacts.target_key                    -> ir_nodes.key
