{
  "name": "flowtracer-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Node Analyzer (sidecar) của CtV Flow Tracer — CLI phân tích Angular (+ PHP-legacy mở rộng). Xem contracts/sidecar-protocol.md",
  "type": "module",
  "bin": {
    "flowtracer-analyzer": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "prebuild": "npm run gen:contracts",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run gen:contracts",
    "test": "vitest run",
    "lint": "npm run gen:contracts && tsc -p tsconfig.json --noEmit && eslint ."
  },
  "dependencies": {
    "@angular/compiler": "^21.2.25",
    "typescript": "~5.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
